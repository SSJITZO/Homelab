# Checks run on Pi 2 itself (Lab VLAN). Format: type  name  arg1  [arg2]

service  suricata          suricata
fresh    suricata-eve      /var/log/suricata/eve.json   900
dns      pinned-dns        1.1.1.1        example.com
service  fail2ban          fail2ban
disk     pi2-root          /              85
# The alert forwarder runs suricata-notify.sh. Confirm its unit name with
#   systemctl list-units --type=service | grep -i notify
# and fix the name below if it differs, then remove the leading #.
#service  alert-forwarder  suricata-notify
